{
  "name": "unime",
  "version": "0.4.0",
  "description": "Unicode Input",
  "main": "src/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.js"
  },
  "repository": "https://github.com/kyungminlee/unime",
  "keywords": [
    "unicode"
  ],
  "author": "Kyungmin Lee",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  },
  "dependencies": {
    "fuzzy-search": "^3.2.1",
    "lru-cache": "^11.0.2"
  },
  "build": {
    "appId": "com.unime.app",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.xz"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "default"
      ],
      "hardenedRuntime": true
    }
  }
}
